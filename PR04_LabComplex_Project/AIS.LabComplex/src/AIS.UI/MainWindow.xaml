<Window x:Class="AIS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АИС Лабораторный комплекс" Height="500" Width="850"
        MinWidth="700" MinHeight="390" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Реестр лабораторных реактивов" FontSize="22"
                   FontWeight="SemiBold" Margin="0,0,0,16"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Обновить" Command="{Binding RefreshCommand}"
                    Width="120" DockPanel.Dock="Right" Margin="12,0,0,0"/>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     Height="32" VerticalContentAlignment="Center" Padding="8,0"
                     ToolTip="Введите название реактива"/>
        </DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Reagents}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Код" Binding="{Binding ExternalCode}" Width="130"/>
                <DataGridTextColumn Header="Партия" Binding="{Binding Lot}" Width="110"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="65"/>
                <DataGridTextColumn Header="Годен до" Binding="{Binding ExpirationDate}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,12,0,0"
                   Foreground="#555555" TextWrapping="Wrap"/>
    </Grid>
</Window>
